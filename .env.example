# Server-side only. Copy to .env; do not commit the populated file.
# Full option descriptions: backend/.env.example
APP_ENV=production
APP_BASE_URL=https://your-app.example.invalid
COOKIE_SECURE=true

# Supabase PostgreSQL (use your project's connection string with TLS).
DATABASE_URL=
DB_POOL_SIZE=5
# Optional DB robustness/diagnostics (defaults shown; details in backend/.env.example):
# DB_CONNECT_TIMEOUT_SECONDS=5
# DB_TCP_KEEPALIVES_IDLE_SECONDS=30
# DB_TCP_KEEPALIVES_INTERVAL_SECONDS=10
# DB_TCP_KEEPALIVES_COUNT=3
# DB_TCP_USER_TIMEOUT_MS=30000
# DB_POOL_TIMEOUT_SECONDS=30
# DB_READY_TIMEOUT_SECONDS=10
# DB_NULL_POOL=false
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Empty for asymmetric JWT signing keys; legacy HS256 projects only:
SUPABASE_JWT_SECRET=

# Reserved for the later AI integration; not implemented in this MVP.
OPENAI_API_KEY=
OPENAI_MODEL=
LOGIN_RATE_LIMIT=10
LOGIN_RATE_WINDOW_SECONDS=300
