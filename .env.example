# Server-side only. Copy to .env; do not commit the populated file.
# Full option descriptions: backend/.env.example
APP_ENV=production
APP_BASE_URL=https://your-app.example.invalid
COOKIE_SECURE=true

# Supabase PostgreSQL (use your project's connection string with TLS).
DATABASE_URL=
DB_POOL_SIZE=5
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Empty for asymmetric JWT signing keys; legacy HS256 projects only:
SUPABASE_JWT_SECRET=

# Reserved for the later AI integration; not implemented in this MVP.
OPENAI_API_KEY=
OPENAI_MODEL=
LOGIN_RATE_LIMIT=10
LOGIN_RATE_WINDOW_SECONDS=300
