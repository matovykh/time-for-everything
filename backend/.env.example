# «Всё успею» backend — placeholders only. Never commit real values.
# Real secrets: environment variables or a 0600 file referenced by CONFIG_FILE
# (e.g. /data/config/app.env on a persistent volume). Environment variables win over the file.

# production | development | test   (insecure cookies are possible only in development)
APP_ENV=production
# Public origin of the app; mutating requests with a foreign Origin header are rejected.
APP_BASE_URL=https://example.invalid

# Supabase PostgreSQL connection string (server-side only). TLS required.
# Direct:  postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres?sslmode=require
# Pooler:  postgresql://postgres.<project-ref>:<password>@<region>.pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=
DB_POOL_SIZE=5

# Supabase Auth. The publishable key (sb_publishable_…) or legacy anon key is used as `apikey`
# for password sign-in/refresh/logout. Do NOT put the secret/service_role key here.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=
# Only for projects still signing JWTs with the legacy HS256 secret; leave empty with JWKS signing keys.
SUPABASE_JWT_SECRET=

# Optional, reported as configured=true/false only. AI mode is not implemented in this MVP.
OPENAI_API_KEY=
OPENAI_MODEL=

# Local http development only (requires APP_ENV=development).
COOKIE_SECURE=true
# Built SPA served by the backend; relative paths resolve from backend/.
FRONTEND_DIST=../frontend/dist
LOGIN_RATE_LIMIT=10
LOGIN_RATE_WINDOW_SECONDS=300
