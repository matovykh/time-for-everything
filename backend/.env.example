# «Всё успею» backend — placeholders only. Never commit real values.
# Real secrets: environment variables or a 0600 file referenced by CONFIG_FILE
# (e.g. /data/config/app.env on a persistent volume). Environment variables win over the file.

# production | development | test   (insecure cookies are possible only in development)
APP_ENV=production
# Public origin of the app; mutating requests with a foreign Origin header are rejected.
APP_BASE_URL=https://example.invalid

# Supabase PostgreSQL connection string (server-side only). TLS required.
# Direct:  postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres?sslmode=require
# Pooler:  postgresql://postgres.<project-ref>:<password>@<region>.pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=
DB_POOL_SIZE=5
# Connection robustness. These override same-named parameters inside DATABASE_URL.
# NOTE: none of these is a total query deadline. connect_timeout bounds connection setup only;
# keepalives/tcp_user_timeout only detect a dead network path (a slow but alive server is not cut off).
DB_CONNECT_TIMEOUT_SECONDS=5
DB_TCP_KEEPALIVES=true
DB_TCP_KEEPALIVES_IDLE_SECONDS=30
DB_TCP_KEEPALIVES_INTERVAL_SECONDS=10
DB_TCP_KEEPALIVES_COUNT=3
# Linux only (ignored elsewhere): max ms sent data may stay unacknowledged; 0 = OS default.
DB_TCP_USER_TIMEOUT_MS=30000
# Pool. Empty DB_MAX_OVERFLOW = same as DB_POOL_SIZE.
DB_MAX_OVERFLOW=
DB_POOL_TIMEOUT_SECONDS=30
DB_POOL_RECYCLE_SECONDS=1800
DB_POOL_PRE_PING=true
# Diagnostics only: new connection for every request (no pooling; pool settings ignored). Slower.
DB_NULL_POOL=false
# Max seconds GET /api/v1/health/ready waits for its database check before answering "timeout".
# Also used as the probe's PostgreSQL SET LOCAL statement_timeout (cancels a slow but reachable server;
# useless against a hung network path). Stale probes are replaced, at most 3 abandoned probe threads;
# if all stay wedged, readiness keeps answering "timeout" until they finish or the process restarts.
DB_READY_TIMEOUT_SECONDS=10

# Supabase Auth. The publishable key (sb_publishable_…) or legacy anon key is used as `apikey`
# for password sign-in/refresh/logout. Do NOT put the secret/service_role key here.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=
# Only for projects still signing JWTs with the legacy HS256 secret; leave empty with JWKS signing keys.
SUPABASE_JWT_SECRET=

# Optional, reported as configured=true/false only. AI mode is not implemented in this MVP.
OPENAI_API_KEY=
OPENAI_MODEL=

# Local http development only (requires APP_ENV=development).
COOKIE_SECURE=true
# Built SPA served by the backend; relative paths resolve from backend/.
FRONTEND_DIST=../frontend/dist
LOGIN_RATE_LIMIT=10
LOGIN_RATE_WINDOW_SECONDS=300
